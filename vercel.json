{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "images": {
    "sizes": [480, 1600],
    "remotePatterns": [
      { "protocol": "https", "hostname": "**" },
      { "protocol": "http", "hostname": "**" }
    ],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 86400
  }
}
